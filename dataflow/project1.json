{
	"name": "project1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet1",
						"type": "DatasetReference"
					},
					"name": "sourceOrderItems"
				},
				{
					"dataset": {
						"referenceName": "sourcestaffdataset",
						"type": "DatasetReference"
					},
					"name": "sourceStaff"
				},
				{
					"dataset": {
						"referenceName": "customerDataSetDf",
						"type": "DatasetReference"
					},
					"name": "customer"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sinkAggregateDF",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "sourceStaff",
						"type": "DatasetReference"
					},
					"name": "sink2"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "customerDAtaSink"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "maskAndCombine"
				},
				{
					"name": "window1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          item_id as string,",
				"          product_id as string,",
				"          quantity as string,",
				"          list_price as string,",
				"          discount as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourceOrderItems",
				"source(output(",
				"          staff_id as string,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          phone as string,",
				"          active as string,",
				"          store_id as string,",
				"          manager_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourceStaff",
				"source(output(",
				"          customer_id as string,",
				"          first_name as string,",
				"          last_name as string,",
				"          phone as string,",
				"          email as string,",
				"          street as string,",
				"          city as string,",
				"          state as string,",
				"          zip_code as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> customer",
				"sourceOrderItems aggregate(groupBy(order_id),",
				"     total_revenue = sum(toDouble(list_price) * toInteger(quantity)),",
				"          total_discount_applied = sum(toDouble(list_price) * toInteger(quantity) * toDouble(discount)),",
				"          total_items_ordered = sum(toInteger(quantity))) ~> aggregate1",
				"sourceStaff derive(email = sha2(256, email),",
				"          StaffName = concat(first_name, ' ',last_name)) ~> maskAndCombine",
				"maskAndCombine window(over(store_id),",
				"     asc(store_id, true),",
				"     totalStoreemployees = count(store_id)) ~> window1",
				"customer derive(Customer_Name = concat(customer_id,' ', last_name),",
				"          PhoneNumber = iif(phone=='NULL', 'No Phone number', phone),",
				"          Address = concat(street,' ',city,' ',state,' ',zip_code),",
				"          email = sha2(256, email)) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          customer_id,",
				"          Customer_Name,",
				"          PhoneNumber,",
				"          Address,",
				"          email",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1",
				"window1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink2",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> customerDAtaSink"
			]
		}
	}
}